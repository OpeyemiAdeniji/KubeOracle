{
  // Everything to work on KubeSift: Python with the dev extras, Docker (for kind and the image), kubectl, Helm and
  // kind. Open in VS Code ("Reopen in Container") or GitHub Codespaces, then: pytest, ruff check src tests,
  // `kind create cluster` and `bash test-scenarios/apply-scenario.sh all` for a cluster with real problems.
  "name": "KubeSift",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {"minikube": "none"}
  },
  "postCreateCommand": "pip install -e '.[dev]' 'mkdocs-material==9.8.1' && curl -sSfLo /tmp/kind https://kind.sigs.k8s.io/dl/v0.33.0/kind-linux-$(dpkg --print-architecture) && sudo install /tmp/kind /usr/local/bin/kind",
  "forwardPorts": [8080, 8000],
  "portsAttributes": {
    "8080": {"label": "kubesift serve"},
    "8000": {"label": "mkdocs serve"}
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "redhat.vscode-yaml", "ms-kubernetes-tools.vscode-kubernetes-tools"],
      "settings": {
        "python.testing.pytestEnabled": true,
        "[python]": {"editor.defaultFormatter": "charliermarsh.ruff"}
      }
    }
  }
}
